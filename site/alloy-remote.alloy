// Remote log collector for VPS hosts — pushes to authenticated Loki ingest on artemis.
discovery.docker "docker_logs" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    target_label = "host"
    replacement  = sys.env("LOG_HOST_NAME")
  }
}

loki.source.docker "docker_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.docker_logs.targets
  forward_to       = [loki.write.remote.receiver]
  relabel_rules    = discovery.relabel.docker_logs.rules
  refresh_interval = "5s"
}

loki.write "remote" {
  endpoint {
    url = sys.env("LOKI_INGEST_URL")

    basic_auth {
      username = sys.env("LOKI_INGEST_USER")
      password = sys.env("LOKI_INGEST_PASSWORD")
    }
  }

  external_labels = {}
}
